{
  "_comment": [
    "ATS-606: one minimal Maestro Flow per command, used to establish the",
    "command inventory BEHAVIOURALLY (maestro check-syntax accepts it or not).",
    "The value is the command's body; the flow is 'appId: com.example.app' + '---' + the body.",
    "Commands whose official page is the inputText page (the inputRandom* family) are",
    "included: they are real Flow commands that the 'Commands available' index page does",
    "not list as separate entries."
  ],
  "appId": "com.example.app",
  "commands": {
    "addMedia": "- addMedia: \"./a.png\"",
    "assertDarkMode": "- assertDarkMode",
    "assertLightMode": "- assertLightMode",
    "assertNoDefectsWithAI": "- assertNoDefectsWithAI",
    "assertNotVisible": "- assertNotVisible: \"Welcome\"",
    "assertScreenshot": "- assertScreenshot: \"splash.png\"",
    "assertTrue": "- assertTrue: ${true}",
    "assertVisible": "- assertVisible: \"Welcome\"",
    "assertWithAI": "- assertWithAI:\n    assertion: \"the screen shows a welcome\"",
    "back": "- back",
    "clearKeychain": "- clearKeychain",
    "clearState": "- clearState",
    "copyTextFrom": "- copyTextFrom: \"Welcome\"",
    "doubleTapOn": "- doubleTapOn: \"Login\"",
    "eraseText": "- eraseText",
    "evalScript": "- evalScript: ${output.x = 1}",
    "extendedWaitUntil": "- extendedWaitUntil:\n    visible: \"Welcome\"\n    timeout: 10000",
    "extractTextWithAI": "- extractTextWithAI: \"the total\"",
    "hideKeyboard": "- hideKeyboard",
    "inputText": "- inputText: \"hello\"",
    "inputRandomCityName": "- inputRandomCityName",
    "inputRandomColorName": "- inputRandomColorName",
    "inputRandomCountryName": "- inputRandomCountryName",
    "inputRandomEmail": "- inputRandomEmail",
    "inputRandomNumber": "- inputRandomNumber",
    "inputRandomPersonName": "- inputRandomPersonName",
    "inputRandomText": "- inputRandomText",
    "killApp": "- killApp",
    "launchApp": "- launchApp",
    "longPressOn": "- longPressOn: \"Login\"",
    "openLink": "- openLink: \"https://example.com\"",
    "pasteText": "- pasteText",
    "pressKey": "- pressKey: Home",
    "repeat": "- repeat:\n    times: 2\n    commands:\n      - tapOn: \"Login\"",
    "retry": "- retry:\n    attempts: 2\n    commands:\n      - tapOn: \"Login\"",
    "runFlow": "- runFlow: other.yaml",
    "runScript": "- runScript: script.js",
    "scroll": "- scroll",
    "scrollUntilVisible": "- scrollUntilVisible:\n    element: \"Login\"",
    "setAirplaneMode": "- setAirplaneMode: on",
    "setClipboard": "- setClipboard: \"text\"",
    "setDarkMode": "- setDarkMode: on",
    "setLocation": "- setLocation:\n    latitude: 52.3599976\n    longitude: 4.8830301",
    "setOrientation": "- setOrientation: LANDSCAPE_LEFT",
    "setPermissions": "- setPermissions:\n    permissions:\n      all: allow",
    "startRecording": "- startRecording: recording",
    "stopApp": "- stopApp",
    "stopRecording": "- stopRecording",
    "swipe": "- swipe:\n    direction: DOWN",
    "takeScreenshot": "- takeScreenshot: \"home\"",
    "tapOn": "- tapOn: \"Login\"",
    "toggleAirplaneMode": "- toggleAirplaneMode",
    "toggleDarkMode": "- toggleDarkMode",
    "travel": "- travel:\n    points:\n      - \"48.8578065, 2.295188\"\n    speed: 150000",
    "waitForAnimationToEnd": "- waitForAnimationToEnd"
  },
  "negativeControls": {
    "_comment": "commands that must be REJECTED -- they prove the check can tell a real command from a typo",
    "notARealCommand": "- notARealCommand: \"x\"",
    "tapon": "- tapon: \"Login\""
  }
}
