-------------------------------------------------------------------
1. the manifest drift gate
-------------------------------------------------------------------
The committed manifest must be checked BEFORE it is regenerated.
Regenerating first compares the file with itself and cannot detect drift.

--- tamper with one integrity value
tampered: "integrity": "sha512-Xz4Tpyki7XyrpbUK1jR1

--- order A (the OLD order): regenerate, then --check
exit code = 0   (0 means the drift was NOT detected)

--- order B (the NEW order): --check first
exit code = 1   (non-zero means the drift WAS detected)

--- order C: regenerate, then git diff --exit-code
exit code = 0   (0 means the drift was NOT detected)
  -> regenerating OVERWRITES the tampered manifest, so a diff taken
     afterwards cannot see the tamper. This is why the gate only
     runs --check.

    RESULT: OK -- the committed dependency manifest matches the lockfiles.
      packages=88 licenceKnown=88 reviewRequired=16
restored; --check exit code = 0

