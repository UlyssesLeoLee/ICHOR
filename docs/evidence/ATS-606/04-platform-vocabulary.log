      optional    : 'id', 'index', 'point', 'retryTapIfNoChange', 'waitToSettleTimeoutMs'
  assertVisible
      primary     : text
      required    : 
      requiredAny : 'text', 'id'
      optional    : 'id', 'index'
  takeScreenshot
      primary     : name
      required    : 
      requiredAny : -
      optional    : 'path'
  recordScreen
      primary     : name
      required    : 
      requiredAny : -
      optional    : 'path'
  readLogs
      primary     : path
