# Fixture dependency trees. The example projects are checked in as SOURCES
# (package.json + spec files); their node_modules are produced by
# `npm install` in the example directory and are not part of the repository.
examples/*/node_modules/

# Locally produced lock files for the example projects. The repository's own
# package-lock.json IS tracked (ATS-102 requires a reproducible install).
examples/*/package-lock.json

# Agent run metadata (Multica runtime), not product source.
.multica/
