node_modules/
.next/
out/
*.tsbuildinfo
src-tauri/target/
# The Rust dependency lock file is a BUILD ARTEFACT, not product source:
# docs/16-BASELINE-ADR.md §5.3 records that it is deliberately NOT under
# version control, and the desktop shell is not built by the ATS-402 gates.
src-tauri/Cargo.lock
.DS_Store
.env*
!.env.example
playwright-report/
test-results/
.atstest/
__pycache__/
*.pyc

# Fixture dependency trees. The example projects are checked in as SOURCES
# (package.json + spec files); their node_modules are produced by
# `npm install` in the example directory and are not part of the repository.
examples/*/node_modules/

# Locally produced lock files for the example projects. The repository's own
# package-lock.json IS tracked (ATS-102 requires a reproducible install).
examples/*/package-lock.json

# Agent run metadata (Multica runtime), not product source.
.multica/

# The Multica agent instructions file is injected into every worktree by the
# runtime, not by the project. It is not product source and must not be
# committed.
AGENTS.md

# The WBS updater's backup of the workbook it is about to rewrite. It is a
# local recovery copy of a binary file, not a deliverable.
docs/WBS.xlsx.bak

# Orchestration scratch files. `multica issue children` dumps and the
# wakeup-instruction buffer are regenerated by tools/wbs_*.py on demand and
# are not product source.
children.json
taskfiles.json
conflict_groups.json
wupd_instr.md
conclusion.md

# The ATS-103 evidence collector's intermediate files. The final log is
# 06-mutation-evidence.log; the .head/.body pair is how the collector
# prepends a provenance block to the script's own output.
docs/evidence/ATS-103/06-mutation-evidence.log.head
docs/evidence/ATS-103/06-mutation-evidence.log.body

# The review probes are downloaded into the worktree during a review round.
.probes/

# The same, under the other name a review round uses.
.probe/

# The reviewer probe material downloaded for a review round: it is INPUT,
# not a deliverable. The evidence the delivery keeps lives in
# docs/evidence/ATS-208/.
.work/
