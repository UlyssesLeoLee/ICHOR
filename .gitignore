node_modules/
.next/
out/
*.tsbuildinfo
src-tauri/target/
# The Rust dependency lock file is a BUILD ARTEFACT, not product source:
# docs/16-BASELINE-ADR.md §5.3 records that it is deliberately NOT under
# version control, and the desktop shell is not built by the ATS-402 gates.
src-tauri/Cargo.lock
.DS_Store
.env*
!.env.example
playwright-report/
test-results/
# The JSON report the Playwright CLI writes when PLAYWRIGHT_JSON_OUTPUT_FILE
# points at it. Inside an example project it is a local run artefact, not
# source; the run's own report lives in the Bridge's run folder.
examples/*/report.json
.atstest/
__pycache__/
*.pyc

# Fixture dependency trees. The example projects are checked in as SOURCES
# (package.json + spec files); their node_modules are produced by
# `npm install` in the example directory and are not part of the repository.
examples/*/node_modules/

# Locally produced lock files for the example projects. The repository's own
# package-lock.json IS tracked (ATS-102 requires a reproducible install).
examples/*/package-lock.json

# ... EXCEPT the ATS-107 real-browser fixture: its lockfile IS the deliverable.
# The acceptance criterion of ATS-107 requires the fixture to pin its
# dependency tree with a lockfile, and a lockfile that is not tracked pins
# nothing for anybody but the machine that generated it.
!examples/real-browser-fixture/package-lock.json

# Agent run metadata (Multica runtime), not product source.
.multica/

# The Multica agent instructions file is injected into every worktree by the
# runtime, not by the project. It is not product source and must not be
# committed.
AGENTS.md

# The WBS updater's backup of the workbook it is about to rewrite. It is a
# local recovery copy of a binary file, not a deliverable.
docs/WBS.xlsx.bak

# Orchestration scratch files. `multica issue children` dumps and the
# wakeup-instruction buffer are regenerated by tools/wbs_*.py on demand and
# are not product source.
children.json
taskfiles.json
conflict_groups.json
wupd_instr.md
conclusion.md

# The ATS-103 evidence collector's intermediate files. The final log is
# 06-mutation-evidence.log; the .head/.body pair is how the collector
# prepends a provenance block to the script's own output.
docs/evidence/ATS-103/06-mutation-evidence.log.head
docs/evidence/ATS-103/06-mutation-evidence.log.body

# The review probes are downloaded into the worktree during a review round.
.probes/

# The same, under the other name a review round uses.
.probe/

# The reviewer probe material downloaded for a review round: it is INPUT,
# not a deliverable. The evidence the delivery keeps lives in
# docs/evidence/ATS-208/.
.work/

# The ATS-203 mutation probe's working copies. The probe snapshots the tree
# under test into `base/` and then copies it once per mutant, so these are
# regenerated scratch trees, not deliverable source. The probe itself
# (tools/ats203-probes/run-mutants.sh, tools/ats203-probes/mutants.py) and
# its OUTPUT (docs/evidence/ATS-203/mutants-output.log) are the deliverables.
tools/ats203-probes/base/
tools/ats203-probes/m-*/

# The ATS-603 smoke fixture's BUILD OUTPUT. The APK is a binary produced by
# tools/ats603-probes/build-smoke-app.sh from the Java source next to it; it
# is regenerated, not authored. The source, the build script and the
# evidence that the APK works are the deliverables.
tools/ats603-probes/build/

# The ATS-104 negative control's WORKING TREE. The control copies the
# product source, mutates the Bridge's exit hook and builds the copy, so the
# copy and its build output are regenerated scratch, not deliverable source.
# The control SCRIPT and its OUTPUT (docs/evidence/ATS-104/) are the
# deliverables.
tools/ats104-probes/control-tree/

# The quality gate's coverage reports. They are regenerated by every run of
# the gate's coverage commands, so they are build output, not source.
.quality/coverage/

# The Tauri build script's generated capability schemas. They are written by
# `tauri-build` on every build, so they are build output, not source.
src-tauri/gen/

# The scratch directory of the reviewer probe attachments (downloaded for a
# rerun, never a deliverable). The probe LOGS that belong to the delivery
# live in docs/evidence/ATS-214/reviewer-probes/.
.probe-work/

# The Multica runtime's per-run metadata dumps. They are written into the
# working directory by the orchestration harness (agent transcripts, issue
# dumps, reviewer instruction files) and are NOT product source. Some of
# them carry a port literal, which the ATS-101 port audit would otherwise
# report as runtime hardcoding -- so they must never be committed.
#
# The patterns are the EXACT file names the harness writes, not a prefix
# wildcard. A prefix wildcard (`c_*.json`) also swallows any legitimate
# file that happens to start with the same letters, and nothing in the
# repository needs that: `git ls-files` matches none of them. The numbered
# variants (`agents2`, `hr2` ... `hr9`, `m3live2`) are the harness's own
# sequence, so the digits are spelled out rather than wildcarded.
agents2.json
agents2.err
agents3.json
agents3.err
hr.json
hr.err
hr2.json
hr2.err
hr3.json
hr3.err
hr4.json
hr4.err
hr5.json
hr5.err
hr6.json
hr6.err
hr7.json
hr7.err
hr8.json
hr8.err
hr9.json
hr9.err
m3b.json
m3live.json
m3live.err
m3live2.json
m3live2.err
m3-conclusion.json
reviewer_instructions.md
