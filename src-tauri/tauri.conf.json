{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Test Studio",
  "version": "0.1.0",
  "identifier": "studio.aitest.local",
  "build": {
    "beforeDevCommand": "npm --prefix apps/studio run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix apps/studio run build",
    "frontendDist": "../apps/studio/out"
  },
  "app": {
    "windows": [
      {
        "title": "AI Test Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  }
}
